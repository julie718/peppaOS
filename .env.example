# ============================================================
# Peppa Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================================

# -------------------------------------------------
# LLM Providers (at least one required)
# -------------------------------------------------

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# DeepSeek (primary — deepseek-chat / deepseek-reasoner)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ── DeepSeek 外部强制路由（任务6：docker 环境变量覆盖 Web 桌面端配置；iPhone App 复用服务端全局配置）──
# 主心智模型（核心心智 InnerTick/TICK/自我反思/MCP评估 强制走此模型，绝不允许交给 flash）
# DEEPSEEK_ROUTER_PRO_MODEL=deepseek-v4-pro
# 备用故障降级模型（仅 pro 返回 API 报错/限流/余额不足时应急降级）
# DEEPSEEK_ROUTER_FLASH_MODEL=deepseek-v4-flash
# 每日 Pro token 预算上限（0=不启用熔断；耗尽后核心心智进入休眠只读模式，数据不丢失，新的一天自动恢复）
# DEEPSEEK_ROUTER_DAILY_PRO_TOKEN_BUDGET=0
# 预算告警阈值比例（0~1，消耗达预算该比例时输出告警日志）
# DEEPSEEK_ROUTER_BUDGET_WARN_RATIO=0.8
# 空闲 InnerTick 推演最小间隔（毫秒，0=不限制保持旧行为；空闲状态只做轻量快照，不调用大模型）
# DEEPSEEK_ROUTER_IDLE_INNERTICK_INTERVAL_MS=3600000
# 路由总开关（false=全部失效回退旧行为）
# DEEPSEEK_ROUTER_ENABLED=true

# ── Phase2：InnerTick 对话回合心智推演总开关 ──
# 每轮用户-助手对话结束后，后台异步触发一轮 InnerTick 心智推演（仅写 inner_tick_snapshot 独立观测表，
# 与旧 life 状态机完全隔离并行运行）。PEPPA_INNER_TICK_ENABLE 仅控制 chat_turn 对话回合触发源；
# scheduler/dream/narrative 等其他 runInnerTick 调用点不受该开关管控。默认 true。
# PEPPA_INNER_TICK_ENABLE=true

# ── Phase3：自主技能拓展系统（技能检索-评估-导入-部署-运行-迭代闭环） ──
# 总开关：false = 一键关闭整套 Phase3（检索/评估/沙箱生成/审批上线/监控自修复/例行巡检/全部路由）。
# Phase-2 收紧：默认 false（灰度开启需显式改为 true）。仅影响 Phase3 新增能力，
# 绝不触碰旧 life 状态机与对话主链路（聊天可正常继续）。
# PEPPA_PHASE3_SKILL_AUTO_ENABLE=false
# 单会话熔断：熔断窗口内单个会话最多新增工具数量（暂存适配 + 沙箱生成合计），超限拒绝创建，
# 输出 breach 事件日志。防"疯狂生成大量工具"。
# PEPPA_PHASE3_MAX_TOOLS_PER_SESSION=10
# 熔断统计窗口（分钟）。
# PEPPA_PHASE3_BREAKER_WINDOW_MINUTES=60
# 全局限额：mcp_skill_store 累计安装上限（DB 持久计数，跨重启有效）。
# PEPPA_PHASE3_GLOBAL_MAX_TOOLS=30
# 风险策略：strict=高风险直接拦截部署+中风险日志告警（默认）；warn=全部放行仅告警。
# PEPPA_PHASE3_RISK_POLICY=strict
# 结构化事件日志开关（检索/评估/安装/生成/调用/卸载 每次动作一条 JSON 事件）。
# PEPPA_PHASE3_STRUCTURED_LOG=true
# 社区 MCP npm 包加载开关（供应链防护）：第三方 npm MCP 包无签名/完整性校验，
# 默认禁止安装加载（false，安装请求直接抛出风险报错）；确认信任包来源后可设为 true 放行。
# ALLOW_UNSIGNED_MCP_NPM_PACKAGES=false

# ── Phase-2 综合修复：节律调度（活跃/半休眠/深度休眠） ──
# 空闲 < ACTIVE_MIN → active（inner_tick 每 ACTIVE_TICK_MIN 分钟一轮）
# ACTIVE_MIN ≤ 空闲 < HALF_SLEEP_HOURS → active（30min-2h 区间不降频）
# HALF_SLEEP_HOURS ≤ 空闲 < DEEP_SLEEP_HOURS → half_sleep（inner_tick 降频 + dream/growth_journal 按日奇偶）
# 空闲 ≥ DEEP_SLEEP_HOURS → deep_sleep（inner_tick 拉长至 120-180min，dream/growth_journal 跳过，
#   consolidate 只延后不删除）；用户发消息立即切回 active。
# DRY_RUN=true 时只记录模式日志、不真正改变调度行为（观测用）。
# PEPPA_RHYTHM_ACTIVE_MIN=30
# PEPPA_RHYTHM_HALF_SLEEP_HOURS=2
# PEPPA_RHYTHM_DEEP_SLEEP_HOURS=6
# PEPPA_RHYTHM_ACTIVE_TICK_MIN=10
# PEPPA_RHYTHM_HALF_TICK_MIN=60
# PEPPA_RHYTHM_DEEP_TICK_MIN=120
# PEPPA_RHYTHM_DRY_RUN=false
# 休眠模式 inner_tick prompt 瘦身（半/深度休眠减量召回快照；活跃模式不受影响）
# PEPPA_INNER_TICK_SLIM=true

# ── Phase-2：后台 LLM 任务并发门闸 / 资源防护 ──
# 同一时刻最多并行执行的后台 LLM 任务数（用户 chat 链路永不经过门闸）
# PEPPA_BG_MAX_CONCURRENT=2
# 排队上限（超出放弃本轮，下一调度周期再试）
# PEPPA_BG_QUEUE_MAX=8
# 排队等待超时（ms），超时放弃本轮
# PEPPA_BG_WAIT_MAX_MS=120000
# 进程堆内存阈值（MB）：超限拒绝启动新后台 LLM 任务（防大 prompt 堆积膨胀）
# PEPPA_BG_MEM_MAX_MB=2048
# 后台 LLM 重试次数（0 = 失败即放弃本轮，防重试风暴；用户 chat 恒 2 次重试不变）
# PEPPA_BG_LLM_RETRY=0
# 调度任务首次触发随机错峰上限（ms），避免启动齐射
# PEPPA_SCHEDULER_STAGGER_MAX_MS=60000

# ── Phase-2：每日后台 token 预算（0 = 不限制） ──
# 非用户场景（chat/task/voice 等白名单外）消耗计入后台额度；额度耗尽 → 后台任务跳过/延后，
# 用户对话不受影响。本地午夜自动重置。
# PEPPA_DAILY_TOKEN_BUDGET=8000000
# 消耗周期日志间隔（分钟，0 = 不输出）
# PEPPA_TOKEN_BUDGET_LOG_INTERVAL_MIN=60

# ── Phase-2：memory_tree 自动整理 prompt 硬上限（防 >1M token 炸弹） ──
# 采样孤儿记忆数 / 树节点数 / 估算 token 硬上限（超出按最低价值孤儿剔除 + 二分裁剪）
# PEPPA_MEMORY_TREE_MAX_ORPHANS=80
# PEPPA_MEMORY_TREE_MAX_TREE_NODES=60
# PEPPA_MEMORY_TREE_MAX_PROMPT_TOKENS=4000

# ── Phase-2：reminder 防洪（重启/停机后不批量补发） ──
# 单轮最多触发条数；过期超时阈值（小时）——超时标记跳过（不删除、不补发）
# PEPPA_REMINDER_MAX_PER_ROUND=5
# PEPPA_REMINDER_MAX_STALE_HOURS=24

# ── Phase-2：inner_tick duration 限流（慢推演冷却放大） ──
# 上一轮 LLM 推演耗时超过 SLOW 阈值 → 本轮最小间隔按 耗时×系数 放大（上限 BACKOFF_MAX）；
# 仅作用于非 chat_turn 推演（chat_turn 对话触发恒豁免，保持纯 3 分钟硬锁，用户对话体验不受影响）；
# LLM 响应正常（耗时 ≤ SLOW）时有效间隔 = 原 3 分钟硬锁，运行行为不变。
# PEPPA_INNER_TICK_DURATION_SLOW_MS=20000
# PEPPA_INNER_TICK_DURATION_BACKOFF_FACTOR=5
# PEPPA_INNER_TICK_DURATION_BACKOFF_MAX_MS=3600000

# ── Phase-2：inner_tick 单轮任务计数上限（LLM 输出条目数保护） ──
# 一轮内实际执行任务数封顶，超限部分留待下一轮；快照观测表仍保留 LLM 完整输出。
# PEPPA_INNER_TICK_MAX_ARCHIVES_PER_ROUND=10
# PEPPA_INNER_TICK_MAX_DESIRE_EVOLVES_PER_ROUND=8

# Qwen / DashScope (Alibaba Cloud — also used by CosyVoice TTS)
DASHSCOPE_API_KEY=
# QWEN_API_KEY=           # alias, falls back to DASHSCOPE_API_KEY
# QWEN_MODEL=qwen-plus

# Doubao / Ark (ByteDance Volcengine)
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-1-5-pro-32k

# Xiaomi (XiaoAi / MiLM)
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=https://api.xiaomi.com/v1
# XIAOMI_MODEL=xiaomi-chat

# Moonshot / Kimi
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k

# Zhipu / GLM
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-plus

# Custom OpenAI-compatible relay
# RELAY_API_KEY=
# RELAY_BASE_URL=https://api.example.com/v1

# -------------------------------------------------
# Local LLM (auto-detected, no key needed)
# -------------------------------------------------

# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234

# -------------------------------------------------
# Voice & Audio
# -------------------------------------------------

# Deepgram (STT — speech to text)
DEEPGRAM_API_KEY=

# Doubao Speech (TTS + STT)
# DOUBAO_SPEECH_KEY=

# GPT-SoVITS (local TTS — requires separate GPT-SoVITS server)
# GPTSOVITS_ENABLED=false
# GPTSOVITS_API_URL=

# -------------------------------------------------
# Auth & Security
# -------------------------------------------------

# JWT signing secret (REQUIRED — use a long random string)
JWT_SECRET=peppa-dev-jwt-20260705

# API Key 加密密钥 (REQUIRED for production — generate with: openssl rand -hex 32)
OXOG_ENV_KEY=

# Auto-login password for admin account (local/dev only)
# AUTO_LOGIN_PASSWORD=

# -------------------------------------------------
# Server Config
# -------------------------------------------------

PORT=3000
NODE_ENV=development

# Bind address (default: 0.0.0.0 — all interfaces, required for LAN)
# HOST=0.0.0.0

# Server role: personal (default) or org (enterprise)
# LUMI_ROLE=personal

# Data directory (default: ~/Peppa/)
# LUMI_DATA_DIR=

# Context token budget for conversations (default: 1,000,000)
# CONTEXT_TOKEN_BUDGET=1000000

# Comma-separated list of allowed shell commands for MCP tools
# LUMI_ALLOWED_COMMANDS=

# -------------------------------------------------
# Messaging Integrations (optional)
# -------------------------------------------------

# Feishu / Lark Bot
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=

# WeCom (企业微信) Bot
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_APP_SECRET=
# WECOM_TOKEN=
# WECOM_ENCODING_AES_KEY=

# WeChat Bot
# WECHAT_BOT_TOKEN=
# WECHAT_BOT_ID=
# WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

