# ============================================================
# Peppa Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================================

# -------------------------------------------------
# LLM Providers (at least one required)
# -------------------------------------------------

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# DeepSeek (primary — deepseek-chat / deepseek-reasoner)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ── DeepSeek 外部强制路由（任务6：docker 环境变量覆盖 Web 桌面端配置；iPhone App 复用服务端全局配置）──
# 主心智模型（核心心智 InnerTick/TICK/自我反思/MCP评估 强制走此模型，绝不允许交给 flash）
# DEEPSEEK_ROUTER_PRO_MODEL=deepseek-v4-pro
# 备用故障降级模型（仅 pro 返回 API 报错/限流/余额不足时应急降级）
# DEEPSEEK_ROUTER_FLASH_MODEL=deepseek-v4-flash
# 每日 Pro token 预算上限（0=不启用熔断；耗尽后核心心智进入休眠只读模式，数据不丢失，新的一天自动恢复）
# DEEPSEEK_ROUTER_DAILY_PRO_TOKEN_BUDGET=0
# 预算告警阈值比例（0~1，消耗达预算该比例时输出告警日志）
# DEEPSEEK_ROUTER_BUDGET_WARN_RATIO=0.8
# 空闲 InnerTick 推演最小间隔（毫秒，0=不限制保持旧行为；空闲状态只做轻量快照，不调用大模型）
# DEEPSEEK_ROUTER_IDLE_INNERTICK_INTERVAL_MS=3600000
# 路由总开关（false=全部失效回退旧行为）
# DEEPSEEK_ROUTER_ENABLED=true

# ── Phase2：InnerTick 对话回合心智推演总开关 ──
# 每轮用户-助手对话结束后，后台异步触发一轮 InnerTick 心智推演（仅写 inner_tick_snapshot 独立观测表，
# 与旧 life 状态机完全隔离并行运行）。PEPPA_INNER_TICK_ENABLE 仅控制 chat_turn 对话回合触发源；
# scheduler/dream/narrative 等其他 runInnerTick 调用点不受该开关管控。默认 true。
# PEPPA_INNER_TICK_ENABLE=true

# ── Phase3：自主技能拓展系统（技能检索-评估-导入-部署-运行-迭代闭环） ──
# 总开关：false = 一键关闭整套 Phase3（检索/评估/沙箱生成/审批上线/监控自修复/例行巡检/全部路由）。
# 默认 true。仅影响 Phase3 新增能力，绝不触碰旧 life 状态机与对话主链路（聊天可正常继续）。
# PEPPA_PHASE3_SKILL_AUTO_ENABLE=true
# 单会话熔断：熔断窗口内单个会话最多新增工具数量（暂存适配 + 沙箱生成合计），超限拒绝创建，
# 输出 breach 事件日志。防"疯狂生成大量工具"。
# PEPPA_PHASE3_MAX_TOOLS_PER_SESSION=10
# 熔断统计窗口（分钟）。
# PEPPA_PHASE3_BREAKER_WINDOW_MINUTES=60
# 全局限额：mcp_skill_store 累计安装上限（DB 持久计数，跨重启有效）。
# PEPPA_PHASE3_GLOBAL_MAX_TOOLS=30
# 风险策略：strict=高风险直接拦截部署+中风险日志告警（默认）；warn=全部放行仅告警。
# PEPPA_PHASE3_RISK_POLICY=strict
# 结构化事件日志开关（检索/评估/安装/生成/调用/卸载 每次动作一条 JSON 事件）。
# PEPPA_PHASE3_STRUCTURED_LOG=true
# 社区 MCP npm 包加载开关（供应链防护）：第三方 npm MCP 包无签名/完整性校验，
# 默认禁止安装加载（false，安装请求直接抛出风险报错）；确认信任包来源后可设为 true 放行。
# ALLOW_UNSIGNED_MCP_NPM_PACKAGES=false

# Qwen / DashScope (Alibaba Cloud — also used by CosyVoice TTS)
DASHSCOPE_API_KEY=
# QWEN_API_KEY=           # alias, falls back to DASHSCOPE_API_KEY
# QWEN_MODEL=qwen-plus

# Doubao / Ark (ByteDance Volcengine)
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-1-5-pro-32k

# Xiaomi (XiaoAi / MiLM)
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=https://api.xiaomi.com/v1
# XIAOMI_MODEL=xiaomi-chat

# Moonshot / Kimi
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k

# Zhipu / GLM
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-plus

# Custom OpenAI-compatible relay
# RELAY_API_KEY=
# RELAY_BASE_URL=https://api.example.com/v1

# -------------------------------------------------
# Local LLM (auto-detected, no key needed)
# -------------------------------------------------

# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234

# -------------------------------------------------
# Voice & Audio
# -------------------------------------------------

# Deepgram (STT — speech to text)
DEEPGRAM_API_KEY=

# Doubao Speech (TTS + STT)
# DOUBAO_SPEECH_KEY=

# GPT-SoVITS (local TTS — requires separate GPT-SoVITS server)
# GPTSOVITS_ENABLED=false
# GPTSOVITS_API_URL=

# -------------------------------------------------
# Auth & Security
# -------------------------------------------------

# JWT signing secret (REQUIRED — use a long random string)
JWT_SECRET=peppa-dev-jwt-20260705

# API Key 加密密钥 (REQUIRED for production — generate with: openssl rand -hex 32)
OXOG_ENV_KEY=

# Auto-login password for admin account (local/dev only)
# AUTO_LOGIN_PASSWORD=

# -------------------------------------------------
# Server Config
# -------------------------------------------------

PORT=3000
NODE_ENV=development

# Bind address (default: 0.0.0.0 — all interfaces, required for LAN)
# HOST=0.0.0.0

# Server role: personal (default) or org (enterprise)
# LUMI_ROLE=personal

# Data directory (default: ~/Peppa/)
# LUMI_DATA_DIR=

# Context token budget for conversations (default: 1,000,000)
# CONTEXT_TOKEN_BUDGET=1000000

# Comma-separated list of allowed shell commands for MCP tools
# LUMI_ALLOWED_COMMANDS=

# -------------------------------------------------
# Messaging Integrations (optional)
# -------------------------------------------------

# Feishu / Lark Bot
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=

# WeCom (企业微信) Bot
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_APP_SECRET=
# WECOM_TOKEN=
# WECOM_ENCODING_AES_KEY=

# WeChat Bot
# WECHAT_BOT_TOKEN=
# WECHAT_BOT_ID=
# WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

# -------------------------------------------------
# Cloud & External Services (optional)
# -------------------------------------------------

# Supabase (cloud sync)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# GitHub (MCP marketplace)
# GITHUB_TOKEN=

# Alibaba Cloud AK (biometrics / real-name verification)
# ALIYUN_AK_ID=
# ALIYUN_AK_SECRET=

# QiChaCha (enterprise legal verification)
# QICHACHA_API_KEY=

# Email (SMTP for sending invitations etc.)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# SiliconFlow (nanobanana skill)
# SILICONFLOW_API_KEY=

# Netease Cloud Music
# NETEASE_APP_ID=
# NETEASE_PRIVATE_KEY=
